{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "importHelpers": true,
    "target": "ES2015",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "cjs",
    "declaration": false,
    "declarationMap": false,
    "downlevelIteration": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.benchmark.*"
  ]
}