{
	"name": "@aicacia/os-example",
	"version": "0.1.0",
	"description": "example package for Aicacia OS",
	"type": "module",
	"keywords": [
		"aicacia",
		"os",
		"example"
	],
	"author": "Nathan Faucett",
	"license": "(MIT OR Apache-2.0)",
	"readmeFilename": "README.md",
	"module": "esm/index.js",
	"main": "cjs/index.js",
	"types": "types/index.d.ts",
	"scripts": {
		"buildTSC": "tsc -b tsconfig.cjs.json",
		"buildESM": "tsc",
		"buildBrowser": "rollup -c",
		"build": "pnpm run clean && pnpm run buildTSC && pnpm run buildESM && pnpm run buildBrowser",
		"doc": "typedoc",
		"prepublishOnly": "pnpm run build",
		"test": "node -r ts-node/register node_modules/tape/bin/tape src/**/*.test.{ts,tsx} | tap-spec",
		"coverage": "nyc --reporter=lcov --check-coverage --lines=75 --require ts-node/register tape src/**/*.test.{ts,tsx} | tap-spec; nyc report ---reporter=text",
		"coverageHTML": "nyc --reporter=lcov --check-coverage --lines=75 --require ts-node/register tape src/**/*.test.{ts,tsx} | tap-spec; nyc report ---reporter=html",
		"clean": "shx rm -rf esm cjs browser types .nyc_output coverage",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"preCommit": "pnpm run format && pnpm run lint && pnpm run coverage",
		"prepare": "husky"
	},
	"husky": {
		"hooks": {
			"pre-commit": "pnpm run preCommit"
		}
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^0.4.0",
		"@rollup/plugin-typescript": "^12.0.0",
		"@types/benchmark": "^2.1.4",
		"@types/tape": "^5.0.8",
		"benchmark": "^2.1.4",
		"husky": "^9.0.11",
		"shx": "^0.3.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"nyc": "^17.1.0",
		"rollup": "^4.9.6",
		"rollup-plugin-esm-import-to-url": "^2.1.0",
		"tap-nyc": "^1.0.0",
		"tap-spec": "^5.0.0",
		"tape": "^5.7.0",
		"ts-node": "^10.9.2",
		"tslib": "^2.6.2",
		"typedoc": "^0.25.4",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.50.1"
	},
	"peerDependencies": {
		"tslib": "^2.6.0"
	},
	"dependencies": {
		"eventemitter3": "^5.0.1"
	},
	"nyc": {
		"include": [
			"src"
		],
		"exclude": [
			"src/**/*.test.*"
		],
		"extension": [
			".ts",
			".tsx"
		]
	}
}