{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"importHelpers": true,
		"target": "ES2015",
		"module": "ES2020",
		"moduleResolution": "node",
		"outDir": "esm",
		"declarationDir": "types",
		"downlevelIteration": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"src/**/*.test.*",
		"src/**/*.benchmark.*"
	],
	"typedocOptions": {
		"entryPoints": [
			"src/index.ts"
		],
		"out": "docs",
		"excludeExternals": true,
		"excludePrivate": true,
		"excludeInternal": true
	}
}