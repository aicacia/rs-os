{
	"name": "@aicacia/automerge-repo-network-webrtc",
	"version": "0.1.0",
	"description": "Automerge Repo Network adapter for WebRTC",
	"type": "module",
	"keywords": [
		"aicacia",
		"automerge",
		"repo",
		"network",
		"webrtc"
	],
	"author": "Nathan Faucett",
	"license": "(MIT OR Apache-2.0)",
	"readmeFilename": "README.md",
	"module": "esm/index.js",
	"main": "cjs/index.js",
	"types": "types/index.d.ts",
	"scripts": {
		"buildESM": "tsc",
		"build": "pnpm run clean && pnpm run buildESM",
		"doc": "typedoc",
		"prepublishOnly": "pnpm run build",
		"test": "node -r ts-node/register node_modules/tape/bin/tape src/**/*.test.{ts,tsx} | tap-spec",
		"coverage": "nyc --reporter=lcov --check-coverage --lines=75 --require ts-node/register tape src/**/*.test.{ts,tsx} | tap-spec; nyc report ---reporter=text",
		"coverageHTML": "nyc --reporter=lcov --check-coverage --lines=75 --require ts-node/register tape src/**/*.test.{ts,tsx} | tap-spec; nyc report ---reporter=html",
		"clean": "shx rm -rf esm types .nyc_output coverage",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"preCommit": "pnpm run lint:fix && pnpm run coverage",
		"prepare": "husky"
	},
	"husky": {
		"hooks": {
			"pre-commit": "pnpm run preCommit"
		}
	},
	"devDependencies": {
		"@aicacia/signaling-room": "workspace:*",
		"@automerge/automerge-repo": "^2.5.1",
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^9.39.2",
		"@types/benchmark": "^2.1.5",
		"@types/tape": "^5.8.1",
		"benchmark": "^2.1.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.0.0",
		"husky": "^9.1.7",
		"nyc": "^17.1.0",
		"prettier": "^3.8.1",
		"shx": "^0.4.0",
		"tap-nyc": "^1.0.3",
		"tap-spec": "^5.0.0",
		"tape": "^5.9.0",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typedoc": "^0.28.16",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1"
	},
	"peerDependencies": {
		"@aicacia/signaling-room": "workspace:*",
		"@automerge/automerge-repo": "2",
		"tslib": "2"
	},
	"dependencies": {
		"@aicacia/peer": "^0.1.5",
		"cbor-x": "^1.6.0",
		"eventemitter3": "^5.0.4"
	},
	"nyc": {
		"include": [
			"src"
		],
		"exclude": [
			"src/**/*.test.*"
		],
		"extension": [
			".ts",
			".tsx"
		]
	}
}