{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"openapi-oidc": "rm -rf src/lib/common/openapi/oidc && openapi-generator-cli generate -i http://localhost:3000/oidc/api/openapi.json -g typescript-fetch -o src/lib/common/openapi/oidc --type-mappings=DateTime=Date --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
		"openapi-admin": "rm -rf src/lib/common/openapi/admin && openapi-generator-cli generate -i http://localhost:3000/admin/api/openapi.json -g typescript-fetch -o src/lib/common/openapi/admin --type-mappings=DateTime=Date --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
		"postinstall": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.1",
		"@inlang/paraglide-js": "^2.5.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22.19.1",
		"dotenv": "^17.2.3",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.45.5",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@nestjs/core",
			"@openapitools/openapi-generator-cli",
			"@tailwindcss/oxide",
			"esbuild"
		]
	},
	"dependencies": {
		"@aicacia/debounce": "^0.1.25",
		"@aicacia/trycatch": "^0.1.1",
		"@lucide/svelte": "^0.553.0",
		"@openapitools/openapi-generator-cli": "^2.25.2",
		"oidc-client-ts": "^3.4.1",
		"valibot": "^1.2.0"
	}
}