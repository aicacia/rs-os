ARG BASE=os-ui:local

FROM --platform=linux/amd64 node:24-trixie-slim AS builder

RUN npm install -g pnpm@10

ARG PROJECT=oidc

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm -C /app/apps/${PROJECT} build

FROM ${BASE}

WORKDIR /app

ARG PROJECT=oidc

COPY --from=builder /app/apps/${PROJECT}/build /app/build